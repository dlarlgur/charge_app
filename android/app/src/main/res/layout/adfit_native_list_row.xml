<?xml version="1.0" encoding="utf-8"?>
<!--
  AdFit 리스트 인-피드 광고 — AdMob(native_ad_list.xml)과 동일한 스테이션 카드
  디자인·다크 대응(@color/ad_* 는 values-night 변형 있음).
  높이는 Flutter 쪽 SizedBox 가 지정(주유 68 / EV 96) — 내용은 세로 중앙 정렬.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/adfit_placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/ad_card_bg" />

    <com.kakao.adfit.ads.na.AdFitNativeAdView
        android:id="@+id/containerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/ad_card_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 아이콘 38x38 (AdMob 카드와 동일) — 미디어(2:1)를 썸네일로 -->
                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/ad_logo_bg"
                    android:clipToOutline="true">

                    <ImageView
                        android:id="@+id/profileIconView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="광고주 아이콘"
                        android:scaleType="centerCrop"
                        tools:src="@mipmap/ic_launcher" />

                    <com.kakao.adfit.ads.na.AdFitMediaView
                        android:id="@+id/mediaView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="광고 미디어" />
                </FrameLayout>

                <!-- 가운데: AD 배지 + 제목 / 본문 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/ad_label_bg"
                            android:includeFontPadding="false"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp"
                            android:text="AD"
                            android:textColor="@color/ad_label_text"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/titleTextView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="@color/ad_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="광고 제목" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/bodyTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/ad_text_secondary"
                        android:textSize="11sp"
                        tools:text="광고 설명 문구" />

                    <!-- 광고주명 — 바인딩 필수라 유지하되 비표시 -->
                    <TextView
                        android:id="@+id/profileNameTextView"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:textSize="1sp"
                        android:visibility="invisible" />
                </LinearLayout>

                <!-- 오른쪽 CTA pill (AdMob 카드와 동일 스타일) -->
                <Button
                    android:id="@+id/callToActionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/ad_cta_bg"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:stateListAnimator="@null"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="설치" />
            </LinearLayout>
        </FrameLayout>
    </com.kakao.adfit.ads.na.AdFitNativeAdView>
</FrameLayout>
